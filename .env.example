# ===== Server only (JANGAN diawali NEXT_PUBLIC_) =====
# Koneksi database PostgreSQL (wajib) — pakai URL pooler untuk runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Koneksi langsung (tanpa pooler) untuk Prisma Migrate — wajib
DIRECT_URL="postgresql://user:password@ep-xxx.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Rahasia sesi NextAuth (wajib) — generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Server key Midtrans (wajib untuk pembayaran online; boleh kosong saat MOCK_PAYMENT=true)
MIDTRANS_SERVER_KEY=""
# Kunci API server internal untuk endpoint bootstrap/seed (wajib)
NEXTAUTH_API_KEY="ganti-dengan-string-acak"

# ===== Boleh diakses client =====
# Client key Midtrans (publik) — wajib jika pembayaran online aktif
MIDTRANS_CLIENT_KEY=""
# URL publik aplikasi, mis. https://rtku.vercel.app (wajib)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Opsional =====
# Mode tiruan pembayaran (tanpa kunci Midtrans). Nilai: "true" / "false"
MOCK_PAYMENT="true"
# Pakai "sandbox" atau "production" untuk Midtrans
MIDTRANS_ENV="sandbox"

# Penyimpanan bukti transfer: Cloudflare R2 (opsional).
# Jika tidak diisi, bukti disimpan lokal di public/uploads (hanya untuk dev).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="rtku-bukti"
R2_PUBLIC_URL=""
